{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Design Tokens — Barrio Abajo del Río / AlegrIA. Estética POP-Folclor · Neobarrial · Graphic Sticker Art.",
  "color": {
    "brand": {
      "yellow": {
        "primary": { "value": "#F2B807", "type": "color", "comment": "Fondo mostaza cálido caribeño base" },
        "light": { "value": "#FFDC43", "type": "color", "comment": "Highlight / Hover de tarjetas" }
      },
      "red": {
        "primary": { "value": "#E02828", "type": "color", "comment": "Acento festival / Bordes / Badges" },
        "dark": { "value": "#A81212", "type": "color", "comment": "Sombras sólidas y bordes de contraste" }
      },
      "blue": {
        "primary": { "value": "#1DB3E7", "type": "color", "comment": "Acento turquesa / Elementos interactivos" },
        "dark": { "value": "#0A749A", "type": "color", "comment": "Bordes y sombras de azul" }
      },
      "orange": {
        "primary": { "value": "#F26522", "type": "color", "comment": "Acento secundario / Warnings / Tags" }
      }
    },
    "neutral": {
      "white": { "value": "#FFFFFF", "type": "color", "comment": "Sticker outlines / Textos sobre rojo-azul" },
      "black": { "value": "#121212", "type": "color", "comment": "Stroke de ilustración y sombras puras" },
      "cream": { "value": "#FDF6E3", "type": "color", "comment": "Fondo alternativo de tarjetas de lectura" }
    },
    "semantic": {
      "bg-canvas": { "value": "{color.brand.yellow.primary}", "type": "color" },
      "bg-surface": { "value": "{color.neutral.cream}", "type": "color" },
      "bg-inverse": { "value": "{color.neutral.black}", "type": "color" },
      "text-on-warm": { "value": "{color.neutral.black}", "type": "color", "comment": "Sobre amarillo/crema — ratio 12.9:1 AAA" },
      "text-on-accent": { "value": "{color.neutral.white}", "type": "color", "comment": "Sobre rojo/azul-dark — ratio ≥ 5.2:1" },
      "interactive": { "value": "{color.brand.blue.primary}", "type": "color" },
      "danger": { "value": "{color.brand.red.primary}", "type": "color" },
      "warning": { "value": "{color.brand.orange.primary}", "type": "color" }
    }
  },
  "typography": {
    "family": {
      "display": { "value": "'Bebas Neue', 'Druk Wide', 'Impact', sans-serif", "type": "fontFamily" },
      "body": { "value": "'Work Sans', 'Inter', system-ui, sans-serif", "type": "fontFamily" }
    },
    "scale": {
      "display-xl": { "fontSize": "4.5rem", "lineHeight": "1.0", "fontWeight": "900", "letterSpacing": "-0.02em" },
      "display-lg": { "fontSize": "3.25rem", "lineHeight": "1.05", "fontWeight": "800", "letterSpacing": "-0.01em" },
      "heading-md": { "fontSize": "2.0rem", "lineHeight": "1.2", "fontWeight": "700", "letterSpacing": "0" },
      "body-lg": { "fontSize": "1.25rem", "lineHeight": "1.5", "fontWeight": "500", "letterSpacing": "0" },
      "body-md": { "fontSize": "1rem", "lineHeight": "1.6", "fontWeight": "400", "letterSpacing": "0" },
      "label-sm": { "fontSize": "0.8125rem", "lineHeight": "1.2", "fontWeight": "700", "letterSpacing": "0.08em" }
    }
  },
  "space": {
    "1": { "value": "4px" }, "2": { "value": "8px" }, "3": { "value": "12px" },
    "4": { "value": "16px" }, "6": { "value": "24px" }, "8": { "value": "32px" },
    "12": { "value": "48px" }, "16": { "value": "64px" }, "24": { "value": "96px" }
  },
  "effects": {
    "shadow": {
      "pop-black": { "value": "5px 5px 0px 0px #121212", "type": "shadow" },
      "pop-red": { "value": "5px 5px 0px 0px #E02828", "type": "shadow" },
      "pop-blue": { "value": "5px 5px 0px 0px #0A749A", "type": "shadow" },
      "pop-xl": { "value": "10px 10px 0px 0px #121212", "type": "shadow", "comment": "Proyección gran formato" },
      "sticker": { "value": "0 0 0 4px #FFFFFF, 5px 5px 0px 0px #121212", "type": "shadow" },
      "pressed": { "value": "2px 2px 0px 0px #121212", "type": "shadow", "comment": "Estado :active — desplazar 3px en X/Y" }
    },
    "border": {
      "sticker": { "value": "4px solid #FFFFFF", "type": "border" },
      "stroke": { "value": "3px solid #121212", "type": "border" },
      "hair": { "value": "2px solid #121212", "type": "border" }
    },
    "radius": {
      "sticker": { "value": "16px" }, "pill": { "value": "9999px" }, "badge": { "value": "8px" }
    },
    "rotate": {
      "sticker-a": { "value": "-2deg" }, "sticker-b": { "value": "1.5deg" }
    }
  },
  "motion": {
    "duration": { "fast": { "value": "120ms" }, "base": { "value": "200ms" } },
    "easing": { "pop": { "value": "cubic-bezier(0.34, 1.56, 0.64, 1)" } }
  }
}
